{
  "name": "tsyvinda.com",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS='--max-old-space-size=4096' next dev",
    "dev:https": "NODE_OPTIONS='--max-old-space-size=4096' next dev --experimental-https --experimental-https-key ./certs/local.tsyvinda.com-key.pem --experimental-https-cert ./certs/local.tsyvinda.com.pem -H local.tsyvinda.com -p 443",
    "dev:local": "NEXT_DIST_DIR=.next-local API_URL=https://api.tsyvinda.local NODE_EXTRA_CA_CERTS=\"$(mkcert -CAROOT)/rootCA.pem\" NODE_OPTIONS='--max-old-space-size=4096' next dev -p 3000",
    "build": "NODE_OPTIONS='--max-old-space-size=4096' next build",
    "start": "next start",
    "lint": "eslint",
    "test": "jest --config config/jest/jest.config.ts",
    "test:watch": "jest --config config/jest/jest.config.ts --watch",
    "test:ci": "jest --config config/jest/jest.config.ts --ci --coverage",
    "test:e2e": "playwright test -c config/playwright/playwright.config.ts",
    "test:e2e:ui": "playwright test -c config/playwright/playwright.config.ts --ui",
    "test:e2e:report": "playwright show-report",
    "storybook": "NODE_OPTIONS='--max-old-space-size=4096' storybook dev -p 6006 -c config/storybook",
    "build-storybook": "NODE_OPTIONS='--max-old-space-size=4096' storybook build -c config/storybook"
  },
  "dependencies": {
    "antd": "^6.6.7",
    "formik": "^2.4.9",
    "framer-motion": "^14.6.0",
    "leaflet": "^1.9.4",
    "lenis": "^1.3.27",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-leaflet": "^5.0.0",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@storybook/nextjs": "^10.6.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jest": "^30.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.3",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "storybook": "^10.6.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
