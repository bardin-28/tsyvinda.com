# Backend base URL — used by the /api/* rewrite and server-side fetches.
# `npm run dev:local` overrides it with the local backend (https://api.tsyvinda.local).
API_URL=https://api.tsyvinda.com

# Analytics (empty = Google Analytics off)
GA_ID=

# Security
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x000000000000000000
